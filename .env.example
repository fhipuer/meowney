# ============================================
# Meowney Environment Variables
# 냥~ 환경 변수 설정 파일 🐱
# ============================================

# Supabase 설정 (필수!)
# 운영 DB는 NAS 영구 볼륨의 SQLite 파일을 사용합니다.
DATABASE_URL=sqlite:////data/meowney.db

# 아래 값은 Supabase에서 최초 데이터를 가져올 때만 필요합니다.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# 투자 레짐 데이터 API (무료 키, 미설정 시 마지막 캐시 또는 설정 필요 상태 표시)
FRED_API_KEY=
KOSIS_API_KEY=

# 백엔드 설정
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# 프론트엔드 설정
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Meowney

# 스케줄러 설정
SNAPSHOT_HOUR=23
SNAPSHOT_MINUTE=0
TIMEZONE=Asia/Seoul

# 환율 (USD -> KRW, 필요시 API 연동)
DEFAULT_USD_KRW_RATE=1350
